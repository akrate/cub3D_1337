{
   X11_malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:malloc
   ...
   obj:/usr/lib/x86_64-linux-gnu/libX11.so*
}

{
   X11_calloc
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:calloc
   ...
   obj:/usr/lib/x86_64-linux-gnu/libX11.so*
}

{
   X11_strdup
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:strdup
   ...
   obj:/usr/lib/x86_64-linux-gnu/libX11.so*
}

{
   Xext_malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:/usr/lib/x86_64-linux-gnu/libXext.so*
}

{
   xcb_malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:/usr/lib/x86_64-linux-gnu/libxcb.so*
}

{
   mlx_internal
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*mlx*
}

